{
  "family": "heramba",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "heramba",
      "image": "ghcr.io/armur-ai/heramba:latest",
      "essential": true,
      "command": ["serve"],
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" },
        { "containerPort": 9090, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "HERAMBA_MODE", "value": "observe" },
        { "name": "HERAMBA_UPSTREAM", "value": "http://127.0.0.1:3000" },
        { "name": "HERAMBA_ADMIN_LISTEN", "value": ":9090" }
      ]
    }
  ]
}
